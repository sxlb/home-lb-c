# 国内镜像加速：VPS 位于中国，直连 npmjs.org 极慢/超时导致构建卡死。
# npm 10 的 replace-registry-host=lockfile 默认会把 lockfile 中的 registry.npmjs.org
# 改写为下方 registry，因此 npm ci 的依赖解析仍与 lockfile 保持一致。
registry=https://registry.npmmirror.com

# 网络韧性：镜像波动时快速失败并重试，而不是挂死数十分钟（2GB 小机 Docker 构建）
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=240000